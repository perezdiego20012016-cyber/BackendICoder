<h1>Productos</h1>
<nav class="categories" aria-label="Filtrar productos por categoría">
  <a href="/products">Todas</a>
  <a href="/products?query=Acidos">Ácidos</a>
  <a href="/products?query=Chocolates">Chocolates</a>
  <a href="/products?query=Paletas">Paletas</a>
</nav>
{{#each groups}}
  <section class="category-section">
    <h2 class="category-title">{{name}}</h2>
    <div class="grid">
      {{#each products}}
        <article class="card">
          {{#if thumbnails.[0]}}<img src="{{thumbnails.[0]}}" alt="{{title}}">{{/if}}
          <h3>{{title}}</h3><p>{{category}}</p><strong>${{price}}</strong>
          <a class="button" href="/products/{{_id}}">Ver detalle</a>
        </article>
      {{/each}}
    </div>
  </section>
{{else}}<p>No hay productos para mostrar.</p>{{/each}}
<nav class="pagination">
  {{#if prevLink}}<a href="{{prevLink}}">← Anterior</a>{{/if}}
  <span>Página {{page}} de {{totalPages}}</span>
  {{#if nextLink}}<a href="{{nextLink}}">Siguiente →</a>{{/if}}
</nav>
